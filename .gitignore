node_modules/
# vendor/ holds the pinned copy of public Rovara Code (vendor/README.md). The links that let Code's own @agentx/* imports resolve inside it are committed.
!/vendor/node_modules/
dist/
build/
coverage/
cdk.out/
.release-synth/
# docs/ stays ignored except the trees the-loop records into (they must be committed).
docs/*
!docs/npm-package.md
!docs/ordered-work.md
!docs/specs/
!docs/decisions/
!docs/learnings/
!docs/capabilities/
!docs/architecture/
!docs/agents/
!docs/runbooks/
!docs/audit-ledger/
!docs/enterprise/
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
.vscode/
.idea/
.env
.env.*
!.env.example
.agentx/
.codex/
*.tsbuildinfo
# Keep .agents/skills/ versioned; it contains Spec Kit instructions, not credentials.

# Evaluation results stay local; only baselines are committed.
tests/eval/results/

# the-loop: generated state under state.root (.the-loop). Local handles never leave
# the machine; .the-loop/portable/ travels with the work, so it is tracked.
.the-loop/local/
.the-loop/logs/
.the-loop/*.pid
.the-loop/poll-status.json
.the-loop/self-diagnosis.json*
.the-loop/channels/
.the-loop/portable/*.tmp
.the-loop/learnings-pending/
work-item-state.lock
graph-state.lock

# TypeScript browser-test build output
.test-build/

# Agents' scratch copies (reviewers and builders keep these inside a worktree); never committed.
/scratchpad/
__pycache__/
*.pyc

# Built by the function runner live tests (scripts/function-runner-live)
scripts/function-runner-live/.build/
