{
  // Stands alone on purpose, so a copy of this directory builds without the monorepo.
  // The compiler options are the same as in tsconfig.base.json at the root of the monorepo this came from,
  // except that declaration maps are off: the published package ships no sources for them to point at.
  // If the base options change, change them here too.
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
