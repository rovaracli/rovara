                      },
                      ". Finish setting it up at ",
                      {
                        "Ref": "SetupPageUrl",
                      },
                      "<br><br>Sign in with your email, {username}, and this temporary password: {####}<br><br>You choose your own password when you first sign in. This temporary password works for 7 days.",
                    ],
                  ],
                },
                "EmailSubject": "Your temporary password",
              },
              {
                "Ref": "AWS::NoValue",
              },
            ],
          },
        },
        "AutoVerifiedAttributes": [
          "email",
        ],
        "DeletionProtection": "ACTIVE",
        "EmailVerificationMessage": "The verification code to your new account is {####}",
        "EmailVerificationSubject": "Verify your new account",
        "EnabledMfas": [
          "SOFTWARE_TOKEN_MFA",
        ],
        "MfaConfiguration": "OPTIONAL",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false,
            "RequireUppercase": true,
