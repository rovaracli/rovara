    "PlanEvidenceServiceRoleDefaultPolicy3BD5AD38": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "xray:PutTraceSegments",
                "xray:PutTelemetryRecords",
              ],
              "Effect": "Allow",
              "Resource": "*",
            },
            {
              "Action": "dynamodb:GetItem",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "DEVTASK#*",
                    "PLAN_EVIDENCE",
                    "ORG#*#PROJECT#*",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "State1C20CC9A",
                  "Arn",
                ],
              },
              "Sid": "ReadTaskJobAndProject",
            },
            {
              "Action": "dynamodb:PutItem",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "DEVTASK#*",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "State1C20CC9A",
                  "Arn",
                ],
              },
              "Sid": "PutEvidencePointer",
            },
            {
              "Action": [
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
              ],
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "PLAN_EVIDENCE",
                  ],
                },
              },
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "State1C20CC9A",
                  "Arn",
                ],
              },
              "Sid": "ClaimAndCloseJobRow",
            },
            {
              "Action": "s3:GetObject",
              "Effect": "Allow",
