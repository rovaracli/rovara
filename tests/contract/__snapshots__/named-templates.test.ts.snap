                  ],
                ],
              },
              "Sid": "ReadPlanDocuments",
            },
            {
              "Action": "s3:PutObject",
              "Effect": "Allow",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    {
                      "Fn::GetAtt": [
                        "Artifacts82DD59A1",
                        "Arn",
                      ],
                    },
                    "/private/*/plan-documents/*.evidence.*.json",
