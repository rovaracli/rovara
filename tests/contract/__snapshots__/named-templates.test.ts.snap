            },
          },
        ],
        "EvaluationPeriods": 1,
        "MetricName": "InvocationThrottles",
        "Namespace": "AWS/Bedrock",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": 5,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
