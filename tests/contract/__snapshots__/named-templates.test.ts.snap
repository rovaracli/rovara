    "TestAccountSecretsRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
              ],
              "Condition": {
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "rovara:org",
                    "rovara:purpose",
                  ],
                },
                "Null": {
                  "aws:RequestTag/rovara:org": "false",
                  "aws:RequestTag/rovara:purpose": "false",
                },
                "StringEquals": {
                  "aws:RequestTag/rovara:purpose": [
                    "store",
                    "resolve",
                  ],
                },
                "StringLike": {
                  "aws:RequestTag/rovara:org": "org_????????????????????",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "BrokerServiceRole1938BCC9",
                    "Arn",
                  ],
                },
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "AgentX customer test account secrets: assumed by the broker with rovara:org and rovara:purpose session tags, reaches only that org's test account secrets",
        "Path": "/agentx/staging/",
        "PermissionsBoundary": {
          "Fn::If": [
            "HasPermissionsBoundary",
            {
              "Ref": "PermissionsBoundaryArn",
            },
            {
              "Fn::Join": [
                "",
                [
                  "arn:",
                  {
                    "Ref": "AWS::Partition",
                  },
                  ":iam::",
                  {
                    "Ref": "AWS::AccountId",
                  },
                  ":policy/agentx/staging/agentx-staging-boundary",
                ],
              ],
            },
          ],
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "secretsmanager:PutSecretValue",
                    "secretsmanager:DescribeSecret",
                    "secretsmanager:DeleteSecret",
                    "secretsmanager:UpdateSecretVersionStage",
                  ],
                  "Condition": {
                    "StringEquals": {
                      "aws:PrincipalTag/rovara:purpose": "store",
                      "aws:ResourceTag/rovara:org": "\${aws:PrincipalTag/rovara:org}",
                      "aws:ResourceTag/rovara:use": "test-account",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":secret:agentx/staging/org-test-accounts/\${aws:PrincipalTag/rovara:org}/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "StoreOwnOrgSecrets",
                },
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Condition": {
                    "StringEquals": {
                      "aws:PrincipalTag/rovara:purpose": "resolve",
                      "aws:ResourceTag/rovara:org": "\${aws:PrincipalTag/rovara:org}",
                      "aws:ResourceTag/rovara:use": "test-account",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":secret:agentx/staging/org-test-accounts/\${aws:PrincipalTag/rovara:org}/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "ResolveOwnOrgSecret",
                },
                {
                  "Action": "secretsmanager:CreateSecret",
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": [
                        "rovara:org",
                        "rovara:use",
                      ],
                    },
                    "StringEquals": {
                      "aws:PrincipalTag/rovara:purpose": "store",
                      "aws:RequestTag/rovara:org": "\${aws:PrincipalTag/rovara:org}",
                      "aws:RequestTag/rovara:use": "test-account",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":secret:agentx/staging/org-test-accounts/\${aws:PrincipalTag/rovara:org}/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "CreateOwnOrgSecrets",
                },
                {
                  "Action": "secretsmanager:TagResource",
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": [
                        "rovara:org",
                        "rovara:use",
                      ],
                    },
                    "StringEquals": {
                      "aws:PrincipalTag/rovara:purpose": "store",
                      "aws:RequestTag/rovara:org": "\${aws:PrincipalTag/rovara:org}",
                      "aws:RequestTag/rovara:use": "test-account",
                    },
                  },
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":secret:agentx/staging/org-test-accounts/\${aws:PrincipalTag/rovara:org}/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "TagOnlyWithCreate",
                },
                {
                  "Action": "secretsmanager:UntagResource",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "NeverUntag",
                },
                {
                  "Action": "secretsmanager:DeleteSecret",
                  "Condition": {
                    "Bool": {
                      "secretsmanager:ForceDeleteWithoutRecovery": "true",
                    },
                  },
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "NeverDeleteWithoutRecovery",
                },
                {
                  "Action": "secretsmanager:GetSecretValue",
