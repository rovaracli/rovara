    "ModelProxyEgress": {
      "Properties": {
        "Description": "Model proxy port 4000 on the proxy load balancer",
        "DestinationSecurityGroupId": {
          "Ref": "ModelProxySecurityGroupId",
        },
        "FromPort": 4000,
        "GroupId": {
          "Fn::GetAtt": [
            "SecurityGroup",
            "GroupId",
          ],
        },
        "IpProtocol": "tcp",
        "ToPort": 4000,
      },
      "Type": "AWS::EC2::SecurityGroupEgress",
    },
    "ModelProxyIngress": {
      "Properties": {
        "Description": "Model proxy port 4000 from the Slack orchestrator",
        "FromPort": 4000,
        "GroupId": {
          "Ref": "ModelProxySecurityGroupId",
        },
        "IpProtocol": "tcp",
        "SourceSecurityGroupId": {
          "Fn::GetAtt": [
            "SecurityGroup",
            "GroupId",
          ],
        },
        "ToPort": 4000,
      },
      "Type": "AWS::EC2::SecurityGroupIngress",
    },
    "SecurityGroup": {
      "Properties": {
        "GroupDescription": "AgentX Slack orchestrator: no ingress and HTTPS-only egress",
        "SecurityGroupEgress": [
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "HTTPS to Slack, Amazon Bedrock, the AgentX control plane, and AWS APIs",
            "FromPort": 443,
            "IpProtocol": "tcp",
            "ToPort": 443,
          },
        ],
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
          {
            "Key": "Application",
            "Value": "AgentX",
          },
        ],
        "VpcId": {
          "Ref": "VpcId",
        },
      },
      "Type": "AWS::EC2::SecurityGroup",
    },
    "Service": {
      "DependsOn": [
        "ActionLogsDelivery",
        "ServiceDeploymentFailureEvents",
      ],
      "Properties": {
        "Cluster": {
          "Ref": "Cluster",
        },
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true,
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
        },
        "DesiredCount": 1,
        "EnableExecuteCommand": false,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              {
                "Fn::GetAtt": [
                  "SecurityGroup",
                  "GroupId",
                ],
              },
            ],
            "Subnets": {
              "Ref": "PrivateSubnetIds",
            },
          },
        },
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "TaskDefinition": {
          "Ref": "TaskDefinition",
        },
      },
      "Type": "AWS::ECS::Service",
    },
    "ServiceDeploymentFailureEvents": {
      "Properties": {
        "Description": "ECS deployment failure events for AgentX staging Slack test attempt",
        "EventPattern": {
          "detail": {
            "eventName": [
              "SERVICE_DEPLOYMENT_FAILED",
            ],
          },
          "detail-type": [
            "ECS Deployment State Change",
          ],
          "resources": [
            {
              "prefix": {
                "Fn::Join": [
                  "",
                  [
                    "arn:",
                    {
                      "Ref": "AWS::Partition",
                    },
                    ":ecs:",
                    {
                      "Ref": "AWS::Region",
                    },
                    ":",
                    {
                      "Ref": "AWS::AccountId",
                    },
                    ":service/",
                    {
                      "Ref": "Cluster",
                    },
                    "/",
                  ],
                ],
              },
            },
          ],
          "source": [
            "aws.ecs",
          ],
        },
        "Name": {
          "Fn::Join": [
            "",
            [
              "agentx-staging-",
              {
                "Fn::Select": [
                  0,
                  {
                    "Fn::Split": [
                      "-",
                      {
                        "Fn::Select": [
                          2,
                          {
                            "Fn::Split": [
                              "/",
                              {
                                "Ref": "AWS::StackId",
                              },
                            ],
                          },
                        ],
                      },
                    ],
                  },
                ],
              },
              "-service-failures",
            ],
          ],
        },
        "State": "ENABLED",
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "ActionLogs3E70FEE0",
                "Arn",
              ],
            },
            "Id": "ActionLogs",
          },
        ],
      },
      "Type": "AWS::Events::Rule",
    },
    "SlackDeliveryFailedAlarm16CEA92A": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "A Slack request was given up after its last attempt, so the member got no answer. Check the Slack service logs for request.abandoned.",
        "AlarmName": "agentx-staging-SlackDeliveryFailed",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "SlackDeliveryFailed",
        "Namespace": "AgentX/staging",
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SlowTurnsAlarmC5F38B31": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "A turn took longer than alerts.slowTurnMinutes. Export recent turns with agentx admin turns export --since 1h.",
        "AlarmName": "agentx-staging-SlowTurns",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "Metrics": [
          {
            "Expression": "slowest / 60000",
            "Id": "expr_1",
            "Label": "Slowest turn in minutes",
            "ReturnData": true,
          },
          {
            "Id": "slowest",
            "MetricStat": {
              "Metric": {
                "MetricName": "TurnDurationMs",
                "Namespace": "AgentX/staging",
              },
              "Period": 300,
              "Stat": "Maximum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": {
          "Ref": "SlowTurnMinutes",
        },
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "TaskDefinition": {
      "Properties": {
        "ContainerDefinitions": [
          {
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": "us-east-1",
              },
              {
                "Name": "CONTROL_PLANE_URL",
                "Value": {
                  "Ref": "ControlPlaneUrl",
                },
              },
              {
                "Name": "SLACK_REQUEST_QUEUE_URL",
                "Value": {
                  "Ref": "SlackRequestQueueUrl",
                },
              },
              {
                "Name": "SLACK_THREADS_TABLE_NAME",
                "Value": {
                  "Ref": "SlackThreadsTableName",
                },
              },
              {
                "Name": "THREAD_SESSION_BUCKET_NAME",
                "Value": {
                  "Ref": "ThreadSessionBucketName",
                },
              },
              {
                "Name": "TURN_RECORDS_TABLE_NAME",
                "Value": {
                  "Ref": "TurnRecordsTableName",
                },
              },
              {
                "Name": "SLACK_SECRET_ARN",
                "Value": {
                  "Ref": "SlackSecretArn",
                },
              },
              {
                "Name": "AGENTX_ORCHESTRATOR_PROVIDER",
                "Value": {
                  "Ref": "ModelProvider",
                },
