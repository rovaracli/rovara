    "SessionsReaperErrorsAlarmE8E9B095": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "The EC2 session idle reaper failed on every run for 15 minutes, or could not check workers against a removed internal address; idle workers are not being stopped, or a removed address may still be open. Check the reaper's logs.",
        "AlarmName": "agentx-staging-SessionReaperErrors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 3,
        "Metrics": [
          {
            "Expression": "FILL(errors, 0) + FILL(unchecked, 0)",
            "Id": "expr_1",
            "ReturnData": true,
          },
          {
            "Id": "errors",
            "MetricStat": {
              "Metric": {
                "Dimensions": [
                  {
                    "Name": "FunctionName",
                    "Value": {
                      "Ref": "SessionsReaper8FEF958E",
                    },
                  },
                ],
                "MetricName": "Errors",
                "Namespace": "AWS/Lambda",
              },
              "Period": 300,
              "Stat": "Sum",
