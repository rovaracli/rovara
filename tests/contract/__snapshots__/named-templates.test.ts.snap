    "SavedEnvImagesCreationTemplate55581766": {
      "DependsOn": [
        "SavedEnvImagesCreateRoleDefaultPolicyA5FAEA7E",
        "SavedEnvImagesCreateRole30347FD6",
        "SavedEnvImagesManageRoleDefaultPolicyB6EE424C",
        "SavedEnvImagesManageRoleA0F3E8CD",
        "SavedEnvImagesPullRoleDefaultPolicy3F49BC10",
        "SavedEnvImagesPullRoleF44C4C9E",
        "SavedEnvImagesPushRoleDefaultPolicy52BB6454",
        "SavedEnvImagesPushRole68F53DE7",
      ],
      "Properties": {
        "AppliedFor": [
          "CREATE_ON_PUSH",
        ],
        "CustomRoleArn": {
          "Fn::GetAtt": [
            "SavedEnvImagesCreateRole30347FD6",
            "Arn",
          ],
        },
        "Description": "Rovara saved environment images: immutable tags, KMS, keep the newest images, data actions for the push and pull roles only",
        "EncryptionConfiguration": {
          "EncryptionType": "KMS",
          "KmsKey": {
            "Fn::GetAtt": [
              "SavedEnvImagesImagesKey550AA1C0",
              "Arn",
            ],
          },
        },
        "ImageTagMutability": "IMMUTABLE",
        "LifecyclePolicy": "{"rules":[{"rulePriority":1,"description":"Untagged images expire","selection":{"tagStatus":"untagged","countType":"sinceImagePushed","countUnit":"days","countNumber":1},"action":{"type":"expire"}},{"rulePriority":2,"description":"Backstop: keep at most 13 images","selection":{"tagStatus":"tagged","tagPatternList":["*"],"countType":"imageCountMoreThan","countNumber":13},"action":{"type":"expire"}}]}",
        "Prefix": "rovara-env/staging",
        "RepositoryPolicy": {
          "Fn::Join": [
            "",
            [
              "{"Version":"2012-10-17","Statement":[{"Sid":"OnlyTheRolesMayRead","Effect":"Deny","Principal":"*","Action":["ecr:BatchGetImage","ecr:GetDownloadUrlForLayer","ecr:BatchCheckLayerAvailability"],"Condition":{"ArnNotEquals":{"aws:PrincipalArn":["",
              {
                "Fn::GetAtt": [
                  "SavedEnvImagesPushRole68F53DE7",
                  "Arn",
                ],
              },
              "","",
              {
                "Fn::GetAtt": [
                  "SavedEnvImagesPullRoleF44C4C9E",
                  "Arn",
                ],
              },
              "","",
              {
                "Fn::GetAtt": [
                  "CompanyImageMirrorMirrorRoleDC4D2A5A",
                  "Arn",
                ],
              },
              ""]}}},{"Sid":"OnlyThePushRoleMayWrite","Effect":"Deny","Principal":"*","Action":["ecr:InitiateLayerUpload","ecr:UploadLayerPart","ecr:CompleteLayerUpload","ecr:PutImage"],"Condition":{"ArnNotEquals":{"aws:PrincipalArn":["",
              {
                "Fn::GetAtt": [
                  "SavedEnvImagesPushRole68F53DE7",
                  "Arn",
                ],
              },
              "","",
              {
                "Fn::GetAtt": [
                  "CompanyImageMirrorMirrorRoleDC4D2A5A",
                  "Arn",
                ],
              },
              ""]}}},{"Sid":"OnlyTheManageRoleMayDeleteImages","Effect":"Deny","Principal":"*","Action":["ecr:BatchDeleteImage"],"Condition":{"ArnNotEquals":{"aws:PrincipalArn":["",
              {
                "Fn::GetAtt": [
                  "SavedEnvImagesManageRoleA0F3E8CD",
                  "Arn",
                ],
              },
              "","",
              {
                "Fn::GetAtt": [
                  "CompanyImageMirrorMirrorRoleDC4D2A5A",
                  "Arn",
                ],
              },
              ""]}}}]}",
            ],
          ],
        },
        "ResourceTags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
          {
            "Key": "rovara:purpose",
            "Value": "saved-environment-image",
          },
        ],
      },
      "Type": "AWS::ECR::RepositoryCreationTemplate",
    },
