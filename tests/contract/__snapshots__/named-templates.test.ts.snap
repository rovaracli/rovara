      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsTopicArn",
          },
        ],
        "AlarmDescription": "Amazon Bedrock throttled the orchestrator model at least 5 times in 5 minutes. Ask for a higher quota in Service Quotas, or choose another model.",
        "AlarmName": "agentx-staging-BedrockThrottling",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
