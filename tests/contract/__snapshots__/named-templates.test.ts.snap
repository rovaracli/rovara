      },
    },
    "TurnRecordsTableName": {
      "Value": {
        "Ref": "TurnRecords69ECFCD9",
      },
    },
  },
  "Parameters": {
    "AdminClaim": {
      "Default": "cognito:groups",
      "Type": "String",
    },
    "AdminValues": {
      "Default": "["agentx-admin"]",
      "Description": "JSON string array of claim values that grant AgentX administrator access",
      "Type": "String",
    },
    "AnthropicSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw Anthropic API key",
      "Type": "String",
    },
    "AutofixEnabled": {
      "AllowedValues": [
        "true",
        "false",
      ],
      "Default": "true",
      "Description": "Whether Rovara sends blocked checks or reviews back to coding by itself, before any pull request exists (agentx config set autofix.enabled false turns it off)",
      "Type": "String",
    },
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
    "BudgetMonthlyUsd": {
      "AllowedPattern": "^(0|[1-9][0-9]{0,6})$",
      "Default": "0",
      "Description": "The environment's monthly AWS budget in US dollars; 0 means no budget",
      "Type": "String",
    },
    "BudgetScope": {
      "AllowedValues": [
        "tag",
        "account",
      ],
      "Default": "tag",
      "Description": "tag: costs tagged agentx:env for this environment (the tag must be activated in Billing); account: the whole account",
      "Type": "String",
    },
    "CoreEngine": {
      "AllowedPattern": "^(off|on|on:org_[0-9a-z]{20}(:org_[0-9a-z]{20})?)$",
      "ConstraintDescription": "must be off, on, or on:<company id> (at most two company ids joined by a colon)",
      "Default": "off",
      "Description": "off: every new task runs Cloud's own flow; on: new tasks of every company start on Rovara Code's core; on:<company id>[:<company id>]: only those companies' new tasks do. A running task keeps the engine it started on. The core's job schedules run only while this is not off (agentx config set coreEngine.switch on:<company id>)",
      "MaxLength": 64,
      "Type": "String",
    },
    "DecisionCardsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "1",
      "Description": "1: decision cards are on (the card routes and the Slack card press); 0: no card route exists and a Slack card press is answered as gone (agentx config set decisionCards.enabled 1)",
      "Type": "String",
    },
    "DesignReviewEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: fresh-context reviewers check the design of a Full task before a person approves it, but only where a company admin has allowed it and the project's mode is not Off (both are set in How we work); 0: no task has a design review, and a review already under way ends at its next step as not run (agentx config set designReview.enabled 1)",
      "Type": "String",
    },
    "DeveloperOidcClientId": {
      "Default": "",
      "Description": "Client ID of the company OIDC app for developer sign-in",
      "MaxLength": 256,
      "Type": "String",
    },
    "DeveloperOidcDisplayName": {
      "Default": "Company sign-in",
      "Description": "Name on the company sign-in button, for example Okta",
      "MaxLength": 40,
      "MinLength": 1,
      "Type": "String",
    },
    "DeveloperOidcIssuer": {
      "AllowedPattern": "^$|^https://\\S+$",
      "Default": "",
      "Description": "Company OIDC issuer URL for developer sign-in; empty turns company sign-in off",
      "Type": "String",
    },
    "DeveloperOidcRequiredClaim": {
      "Default": "",
      "Description": "Claim a company sign-in must carry, for example groups; empty for none",
      "MaxLength": 128,
      "Type": "String",
    },
    "DeveloperOidcRequiredValues": {
      "AllowedPattern": "^\\[.*\\]$",
      "Default": "[]",
      "Description": "JSON string array; the required claim must contain one of these values",
      "Type": "String",
    },
    "DeveloperOidcSince": {
      "AllowedPattern": "^[0-9]{1,12}$",
      "Default": "0",
      "Description": "When company sign-in was last turned on, in epoch seconds; company sessions started before it are refused",
      "Type": "String",
    },
    "DeveloperSignInSlack": {
      "AllowedValues": [
        "enabled",
        "disabled",
      ],
      "Default": "disabled",
      "Description": "enabled: developers may sign in with Slack; disabled: they may not",
      "Type": "String",
    },
    "DeveloperSignInSlackSince": {
      "AllowedPattern": "^[0-9]{1,12}$",
      "Default": "0",
      "Description": "When Slack sign-in was last turned on, in epoch seconds; Slack sessions started before it are refused",
      "Type": "String",
    },
    "DispatcherSecurityGroupId": {
      "Description": "The foundation's dispatcher security group",
      "Type": "String",
    },
    "Ec2WorkerInstanceRoleArn": {
      "Description": "The EC2 workers' instance role",
      "Type": "String",
    },
    "Ec2WorkerLaunchTemplateId": {
      "AllowedPattern": "^lt-[0-9a-f]{17}$",
      "Description": "The EC2 workers' launch template",
      "Type": "String",
    },
    "Ec2WorkerSubnets": {
      "Description": "The foundation's EC2 worker subnets, as availabilityZone=subnetId pairs",
      "Type": "String",
    },
    "GitHubAppCredentialRef": {
      "AllowedPattern": "^[A-Za-z0-9._:-]{0,64}$",
      "Default": "github-agentx-sdlc",
      "Type": "String",
    },
    "GitHubAppId": {
      "AllowedPattern": "^[A-Za-z0-9._:-]{0,64}$",
      "Default": "",
      "Description": "GitHub App id; empty reads it from the private-key secret's appId",
      "Type": "String",
    },
    "GitHubAppPrivateKeySecretArn": {
      "Description": "Complete Secrets Manager ARN containing the GitHub App private key PEM",
      "Type": "String",
    },
    "InsightsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: Insights is on (the Insights reads and the viewer grant; the screen also needs its own app switch); 0: every Insights path but the overview answers as an unknown path (agentx config set insights.enabled 1)",
      "Type": "String",
    },
    "LearnedLessonsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: approved lessons are loaded into an agent's prompt (only after the worker image that carries task.learnedContext.v1 is deployed; needs the Team record); 0: no lesson is loaded or sent to an agent, even where the Team record is on (agentx config set learnedLessons.enabled 1)",
      "Type": "String",
    },
    "LearningSuggestionsDefault": {
      "AllowedValues": [
        "on",
        "off",
      ],
      "Default": "off",
      "Description": "Whether a company that has not chosen gets suggested rules from Rovara's learning (on) or only has its corrections collected (off). A company's own choice always wins. Off unless an operator turns it on",
      "Type": "String",
    },
    "LiveAskEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: Ask about this task is on (only after the chat service that carries the Ask route is deployed); 0: every Ask route answers not found (agentx config set liveAsk.enabled 1)",
      "Type": "String",
    },
    "LiveFixEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: Fix with agent is on (only after the chat service that carries the diagnosis route is deployed); 0: every diagnosis route answers not found (agentx config set liveFix.enabled 1)",
      "Type": "String",
    },
    "LiveRedirectEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: the task owner can stop a running step and redirect it with a new instruction (only after the dispatcher, broker and worker image that carry Stop & redirect are deployed); 0: the redirect route is off (agentx config set liveRedirect.enabled 1)",
      "Type": "String",
    },
    "LiveSteerEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: a person's message to a running step is given to it live (only after the dispatcher, publisher, broker and worker image that carry live steer are deployed); 0: every message waits as a note for the next step (agentx config set liveSteer.enabled 1)",
      "Type": "String",
    },
    "McpConfirmElicitation": {
      "AllowedValues": [
        "enabled",
        "disabled",
      ],
      "Default": "enabled",
      "Description": "enabled: an admin may confirm a change from an AI tool in the tool's own pop-up; disabled: only the Slack Confirm button (or the CLI)",
      "Type": "String",
    },
    "NightlyHealthEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: the nightly run sets the project's health (Setup needs repair, a Fix setup card, a start banner; needs the test environment); 0: no health is recorded or shown (agentx config set nightlyHealth.enabled 1)",
      "Type": "String",
    },
    "OidcAudience": {
      "Type": "String",
    },
    "OidcIssuer": {
      "Type": "String",
    },
    "OpenAISecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenAI API key",
      "Type": "String",
    },
    "OpenRouterSecretArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$",
      "Default": "",
      "Description": "Optional Secrets Manager ARN containing the raw OpenRouter API key",
      "Type": "String",
    },
    "PermissionsBoundaryArn": {
      "AllowedPattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:policy/.+$",
      "Default": "",
      "Description": "Optional IAM boundary ARN; empty uses AgentX's default",
      "Type": "String",
    },
    "PlanSelfCheckEnabled": {
      "AllowedValues": [
        "true",
        "false",
      ],
      "Default": "true",
      "Description": "Whether every coding plan is checked before the owner sees it, and the planner asked again once when the check finds a fixable problem (agentx config set planSelfCheck.enabled false turns it off; it also turns off checking the plan against the current app)",
      "Type": "String",
    },
    "PrivateSubnetIds": {
      "Description": "Comma-separated private subnet IDs of the foundation VPC",
      "Type": "String",
    },
    "ProjectImagesEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: a project may bring its own images for a dependency (reviewed compose services, a model image); needs testServices.enabled; 0: only Rovara's image catalog is used (agentx config set projectImages.enabled 1)",
      "Type": "String",
    },
    "ProofEvidenceEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: the evidence of a task's checks is gathered, kept and shown (only after the worker image that carries task.evidenceCapture.v1 is deployed); 0: nothing new is gathered, posted to a pull request or served (agentx config set proofEvidence.enabled 1)",
      "Type": "String",
    },
    "RovaraCodeV2Enabled": {
      "AllowedValues": [
        "true",
        "false",
      ],
      "Default": "false",
      "Description": "Whether Rovara Code version 2 (Understand, the plan check, parallel parts, merge tracking) is available in this environment: an admin may adopt it and new tasks of an org that did run it. Off unless an operator turns it on (agentx config set rovaraCode.v2 true)",
      "Type": "String",
    },
    "SavedEnvEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: a project's proven setup can be built into a saved image and used by tasks (deploy the worker image and the registry roles first); 0: nothing is built, pushed, pulled or sent to a worker (agentx config set savedEnv.enabled 1)",
      "Type": "String",
    },
    "ScriptTokensEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: people can make script tokens in the app settings so their scripts and CI can read and start their own tasks; 0: no token can be made and every script token is refused (agentx config set scriptTokens.enabled 1)",
      "Type": "String",
    },
    "SecondReviewEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: an added second review by a model of a different AI company is on (a project or company chooses shadow or on; only after the worker image that runs the second review is deployed); 0: no second review is planned, run or shown (agentx config set secondReview.enabled 1)",
      "Type": "String",
    },
    "SessionManagerSecurityGroupId": {
      "Description": "The foundation's session manager security group",
      "Type": "String",
    },
    "SetupAgentEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: Set up this project can start a live setup run that runs commands in a sandbox (turn on only after the five Linux checks of SH-1 pass and the worker image that carries task.setupAgent.v1 is deployed); 0: setup is the read-only draft, the prove run and the confirm card, as before",
      "Type": "String",
    },
    "SetupRecipesEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: approved company setup recipes are offered to a project's setup run as a proposal source (each value they add is cited as the recipe's and is still proved and confirmed; only after the worker image that reads recipe offers is deployed); 0: no recipe is offered (agentx config set setupRecipes.enabled 1)",
      "Type": "String",
    },
    "SlackAppPostedMessages": {
      "AllowedValues": [
        "accept",
        "ignore",
      ],
      "Default": "accept",
      "Description": "accept: answer mentions a person posts through another app with their own Slack token; ignore: answer only typed mentions",
      "Type": "String",
    },
    "SlackExplicitMembers": {
      "AllowedValues": [
        "0",
        "1",
        "warn",
      ],
      "Default": "1",
      "Description": "1: a Slack person who is not an explicit, current member of the company (not removed, not banned) is not served in Slack and is told to ask an admin to add them or to link their account; warn: today's access is kept and each such person gets one direct message that a membership will soon be needed; 0: today's behaviour, a Slack person with no membership is served as an implicit member (agentx config set slack.explicitMembers warn)",
      "Type": "String",
    },
    "SlackMemberWorkspaceLimit": {
      "Default": 3,
      "Description": "Maximum Slack thread workspaces one channel member may start",
      "MinValue": 1,
      "Type": "Number",
    },
    "SlackOrganizationWorkspaceLimit": {
      "Default": 20,
      "Description": "Maximum Slack thread workspaces for the whole Slack organization",
      "MinValue": 1,
      "Type": "Number",
    },
    "SlackTeamId": {
      "AllowedPattern": "^$|^[TE][A-Z0-9]{2,31}$",
      "Default": "",
      "Description": "The Slack workspace (team) ID this environment serves; Slack sign-in is refused while it is empty",
      "Type": "String",
    },
    "SlackThreadTurnsPerMinute": {
      "AllowedPattern": "^([1-9]|[1-5][0-9]|60)$",
      "ConstraintDescription": "must be a whole number from 1 to 60",
      "Default": "6",
      "Description": "Most requests one Slack thread may start in a minute; further requests pause the thread with one notice",
      "Type": "String",
    },
    "StandingInstructionsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: the project's How we work reaches every step in the system prompt, in one block with the company's rules and the precedence wording (turn on only after the worker image that carries task.standingInstructions.v1 is deployed); 0: How we work stays in the user message (agentx config set standingInstructions.enabled 1)",
      "Type": "String",
    },
    "TaskPersonProofEnabled": {
      "AllowedValues": [
        "true",
        "false",
      ],
      "Default": "false",
      "Description": "Install the dedicated task person proof workload on its own. It is installed anyway while TaskPeopleChangesEnabled is true; with both false nothing is created",
      "Type": "String",
    },
    "TestAccountsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: a project may use the customer's own test accounts for a dependency, each approved by a second admin (needs testServices.enabled; turn on only after the test-account proxy is deployed); 0: no test account is stored, approved or used (agentx config set testAccounts.enabled 1)",
      "Type": "String",
    },
    "TestEnvironmentEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: the project test environment is on (propose, prove, approve, and tasks use it; only after the worker image that carries task.testEnvDetect.v1 and task.testEnvironment.v1 is deployed); 0: nothing about test environments changes (agentx config set testEnvironment.enabled 1)",
      "Type": "String",
    },
    "TestServicesEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: a project's dependencies (databases, caches, queues, AWS services, outside APIs) get a backing for test runs on a sealed per-run network (turn on only after the Linux checks TS-L1 to TS-L6 pass and the worker image that carries the service runner is deployed); 0: today's flow, services are refused as before (agentx config set testServices.enabled 1)",
      "Type": "String",
    },
    "UiFlagsForceOff": {
      "AllowedPattern": "^(none|all|[A-Za-z]+(-[A-Za-z]+)*)$",
      "Default": "none",
      "Description": "Screens to hold back for every company on this install, whatever a company chose in the app: none, all, or screen names joined by a hyphen (look-nav-home-work-spending-leadingHeader are the ones that exist today). A name the broker does not know turns every screen off (fail closed). Companies turn screens on in the app with no deploy; this is the operator's emergency lever (agentx config set ui.forceOff <value>)",
      "MaxLength": 64,
      "Type": "String",
    },
    "VerifyResultsEnabled": {
      "AllowedValues": [
        "0",
        "1",
      ],
      "Default": "0",
      "Description": "1: tasks and pull requests show one of four test results and a Testing section, and an environment fault opens a Fix setup card (only after the broker that carries the new auto-fix codes is deployed); 0: nothing about test results changes (agentx config set verifyResults.enabled 1)",
      "Type": "String",
    },
    "WorkflowDependenciesEnabled": {
      "AllowedValues": [
        "true",
        "false",
      ],
      "Default": "false",
      "Description": "Whether bounded serial task work breakdowns are enabled in this environment",
      "Type": "String",
    },
    "WorkspaceKmsKeyArn": {
      "Description": "The foundation's workspace volume KMS key",
      "Type": "String",
    },
  },
  "Resources": {
    "AgentSessionSweepSchedule": {
      "Properties": {
        "FlexibleTimeWindow": {
