          "Ref": "HttpApi",
        },
        "AutoDeploy": true,
        "RouteSettings": {
          "ANY /review/{proxy+}": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "ANY /s/{proxy+}": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "ANY /v1/app/{proxy+}": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "ANY /v1/auth/{proxy+}": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "ANY /v1/dev/{proxy+}": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "ANY /v1/web/{proxy+}": {
            "ThrottlingBurstLimit": 400,
            "ThrottlingRateLimit": 200,
          },
          "GET /app": {
            "ThrottlingBurstLimit": 200,
            "ThrottlingRateLimit": 100,
          },
          "GET /app/{proxy+}": {
            "ThrottlingBurstLimit": 200,
            "ThrottlingRateLimit": 100,
          },
          "GET /join": {
            "ThrottlingBurstLimit": 200,
            "ThrottlingRateLimit": 100,
          },
          "GET /s/{sessionId}": {
            "ThrottlingBurstLimit": 200,
            "ThrottlingRateLimit": 100,
          },
          "GET /v1/github/install/callback": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
          "POST /v1/github/install/confirm": {
            "ThrottlingBurstLimit": 50,
            "ThrottlingRateLimit": 20,
          },
        },
        "StageName": "$default",
