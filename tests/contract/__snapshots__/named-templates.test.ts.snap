            "ReturnData": false,
          },
          {
            "Id": "unchecked",
            "MetricStat": {
              "Metric": {
                "MetricName": "SessionsPrivateAddressRecycleErrors",
                "Namespace": "AgentX/staging",
              },
              "Period": 300,
              "Stat": "Sum",
            },
            "ReturnData": false,
          },
        ],
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
