        "AlarmName": "agentx-staging-StuckSetupChecks",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 2,
        "MetricName": "ReconcilerStuckSetupChecksKept",
        "Namespace": "AgentX/staging",
        "Period": 600,
        "Statistic": "Maximum",
        "Tags": [
