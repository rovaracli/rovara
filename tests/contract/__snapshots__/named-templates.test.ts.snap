    "SessionsStuckProvisioningAlarm53058404": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "OperatorAlertsA2431256",
          },
        ],
        "AlarmDescription": "An EC2 session provisioning ended without finishing and was marked failed by the reconciler. Open the provisioner execution named in the reconciler's logs.",
        "AlarmName": "agentx-staging-ReconcilerStuckProvisioning",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "EvaluationPeriods": 1,
        "MetricName": "ReconcilerStuckProvisioning",
        "Namespace": "AgentX/staging",
        "Period": 900,
        "Statistic": "Maximum",
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching",
      },
      "Type": "AWS::CloudWatch::Alarm",
    },
    "SessionsStuckSetupChecksAlarm69266D82": {
      "Properties": {
