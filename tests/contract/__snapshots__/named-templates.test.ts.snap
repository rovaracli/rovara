    "TaskPersonProofDispatcherPolicyA9AE8601": {
      "Condition": "TaskPersonProofInstallTaskPersonProofE63432B2",
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "dynamodb:GetItem",
              ],
              "Condition": {
                "ForAllValues:StringEquals": {
                  "dynamodb:Attributes": [
                    "pk",
                    "sk",
                    "developerId",
                    "provider",
                    "issuer",
                    "subject",
                    "slackUserId",
                    "revoked",
                    "mergedInto",
                    "displayName",
                  ],
                },
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "DEVELOPER#*",
                  ],
                },
                "Null": {
                  "dynamodb:Attributes": "false",
                  "dynamodb:LeadingKeys": "false",
                },
              },
              "Effect": "Allow",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DeveloperSignInTable26CE739E",
                    "Arn",
                  ],
                },
              ],
            },
            {
              "Action": [
                "dynamodb:GetItem",
              ],
              "Condition": {
                "StringNotEqualsIfExists": {
                  "dynamodb:Select": "SPECIFIC_ATTRIBUTES",
                },
              },
              "Effect": "Deny",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DeveloperSignInTable26CE739E",
                    "Arn",
                  ],
                },
              ],
              "Sid": "DenyGetItemUnlessSpecificAttributes",
            },
            {
              "Action": [
                "lambda:InvokeFunction",
              ],
              "Effect": "Allow",
              "Resource": [
                {
                  "Ref": "TaskPersonProofFunctionCurrentVersion<code-hash>",
                },
              ],
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "staging-task-person-proof-dispatcher",
        "Roles": [
          {
            "Ref": "DispatcherServiceRole904BCD09",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
