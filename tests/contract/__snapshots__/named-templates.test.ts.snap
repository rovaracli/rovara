      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
              ],
              "Condition": {
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": [
                    "rovara:org",
                  ],
                },
                "Null": {
                  "aws:RequestTag/rovara:org": "false",
                },
                "StringLike": {
                  "aws:RequestTag/rovara:org": "org_????????????????????",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "BrokerServiceRole1938BCC9",
                    "Arn",
                  ],
                },
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "AgentX org connector and hook secrets: assumed by the broker with a rovara:org session tag, reaches only that org's secrets",
        "Path": "/agentx/staging/",
        "PermissionsBoundary": {
          "Fn::If": [
            "HasPermissionsBoundary",
            {
              "Ref": "PermissionsBoundaryArn",
            },
            {
              "Fn::Join": [
                "",
