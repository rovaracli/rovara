                      ],
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition",
                          },
                          ":secretsmanager:",
                          {
                            "Ref": "AWS::Region",
                          },
                          ":",
                          {
                            "Ref": "AWS::AccountId",
                          },
                          ":secret:agentx/staging/org-hooks/\${aws:PrincipalTag/rovara:org}/*",
                        ],
                      ],
                    },
                  ],
                  "Sid": "TagOnlyWithCreate",
                },
                {
                  "Action": "secretsmanager:UntagResource",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "NeverUntag",
                },
                {
                  "Action": "secretsmanager:DeleteSecret",
                  "Condition": {
