                            {
                              "Ref": "AWS::StackId",
                            },
                          ],
                        },
                      ],
                    },
                    ":log-stream:*",
                  ],
                ],
              },
              "Sid": "AllowEcsDeploymentFailureEvents",
            },
          ],
          "Version": "2012-10-17",
        },
        "RetentionInDays": 30,
        "Tags": [
          {
            "Key": "agentx:env",
            "Value": "staging",
          },
        ],
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Retain",
    },
    "ActionLogsDelivery": {
      "DependsOn": [
        "ActionLogs3E70FEE0",
