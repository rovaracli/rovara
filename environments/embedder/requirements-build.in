# Build stage only (export, check against the original weights). The top-level choices; requirements-build.lock is the full closure with a sha256 for every file.
# Regenerate: uv pip compile requirements-build.in --generate-hashes --no-build --python-version 3.12 --python-platform aarch64-manylinux_2_28 -o requirements-build.lock
# models.lock.json "toolchain" names torch (2.15.0), transformers, onnx, onnxruntime and tokenizers at the versions pinned here; tests/unit/embedder/spec.test.ts keeps them equal.
# torch is pinned by URL and hash, from the PyTorch CPU wheels: the PyPI build for aarch64 pulls in the CUDA libraries (about 3 GB the export never uses). No extra package index is used
# anywhere, so no package can come from a second index.
torch @ https://download-r2.pytorch.org/whl/cpu/torch-2.15.0%2Bcpu-cp312-cp312-manylinux_2_28_aarch64.whl
transformers==5.22.2
onnx==1.23.2
onnxruntime==1.31.1
tokenizers==0.23.3
numpy==2.5.4
huggingface_hub==2.4.0
sentence-transformers==6.2.0
