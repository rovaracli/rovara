  "schemaVersion": 1,
  "entries": [
    {
      "id": "lambda-python@3.12",
      "family": "lambda-python",
      "backing": "local",
      "version": "3.12",
      "status": "available",
      "image": {
        "repository": "svc/lambda-python",
        "platforms": [
          "linux/arm64"
        ]
      },
      "run": {
        "user": "993:993",
        "readOnlyRoot": true,
        "tmpfs": [
          {
            "path": "/tmp",
            "sizeMiB": 64
          }
        ],
        "ports": [
          9001
        ],
        "extraArgs": []
      },
      "health": {
        "kind": "tcp",
        "port": 9001,
        "startTimeoutS": 30
      },
      "resources": {
        "memMiB": 128,
        "cpus": 0.25,
        "pids": 256
      },
      "connect": {
        "templates": {},
        "defaultAliases": []
      },
      "reset": {
        "kind": "restart"
      },
      "licence": "LicenseRef-AmazonLinux-2023 AND Apache-2.0",
      "editions": [
        "public",
        "enterprise"
      ]
    },
