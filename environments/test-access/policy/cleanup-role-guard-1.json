{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyChangesToOtherResources1",
      "Effect": "Deny",
      "Action": [
        "apigateway:DeletePortal",
        "apigateway:DeletePortalProduct",
        "apigateway:DeleteProductPage",
        "apigateway:DeleteProductRestEndpointPage",
        "dynamodb:DeleteGlobalTableWitness",
        "dynamodb:DeleteItem",
        "dynamodb:DeleteTable",
        "dynamodb:DeleteTableReplica",
        "events:DeleteEventBus",
        "events:DeleteEventSource",
        "events:DeleteRule",
        "events:DeleteSubscriber",
        "events:RemoveTargets",
        "iam:DeleteAccessKey",
        "iam:DeleteInstanceProfile",
        "iam:DeleteLoginProfile",
        "iam:DeleteOpenIDConnectProvider",
        "iam:DeleteRole",
        "iam:DeleteSAMLProvider",
        "iam:DeleteSSHPublicKey",
        "iam:DeleteServerCertificate",
        "iam:DeleteServiceLinkedRole",
        "iam:DeleteServiceSpecificCredential",
        "iam:DeleteSigningCertificate",
        "iam:DeleteUser",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:RemoveRoleFromInstanceProfile",
        "kinesis:Delete*",
        "kinesis:DeregisterStreamConsumer",
        "kms:DeleteImportedKeyMaterial",
        "lambda:DeleteAlias",
        "lambda:DeleteCapacityProvider",
        "lambda:DeleteCodeSigningConfig",
        "lambda:DeleteEventSourceMapping",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionCodeSigningConfig",
        "lambda:DeleteFunctionConcurrency",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:DeleteMicrovmImage",
        "lambda:DeleteMicrovmImageVersion",
        "lambda:DeleteNetworkConnector",
        "lambda:DeleteProvisionedConcurrencyConfig",
        "lambda:DeleteWebFunction",
        "lambda:DeleteWebFunctionEndpoint",
        "lambda:DeleteWebFunctionRevision",
        "lambda:TerminateMicrovm",
        "logs:DeleteDataProtectionPolicy",
        "logs:DeleteDelivery",
        "logs:DeleteDeliveryDestination",
        "logs:DeleteDeliveryDestinationPolicy",
        "logs:DeleteDeliverySource",
        "logs:DeleteDestination",
        "logs:DeleteLogAnomalyDetector",
        "logs:DeleteLogGroup",
        "logs:DeleteLogStream",
        "logs:DeleteLookupTable",
        "logs:DeleteMetricFilter",
        "logs:DeleteRetentionPolicy",
        "logs:DeleteScheduledQuery",
        "logs:DeleteSubscriptionFilter",
        "logs:DeleteSyslogConfiguration",
        "logs:DeleteTransformer",
        "s3:DeleteStorageLensConfiguration",
        "s3:DeleteStorageLensGroup",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RemoveRegionsFromReplication",
        "sns:DeleteTopic",
        "sqs:DeleteMessage",
        "sqs:DeleteQueue",
        "sqs:PurgeQueue",
        "ssm:DeleteAssociation",
        "ssm:DeleteCloudConnector",
        "ssm:DeleteDocument",
        "ssm:DeleteMaintenanceWindow",
        "ssm:DeleteOpsItem",
        "ssm:DeleteOpsMetadata",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:DeletePatchBaseline",
        "ssm:DeregisterManagedInstance",
        "ssm:DeregisterPatchBaselineForPatchGroup",
        "ssm:DeregisterTargetFromMaintenanceWindow",
        "ssm:DeregisterTaskFromMaintenanceWindow",
        "states:Delete*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/rovara-run": "${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "DenyChangesOutsideRunNames1",
      "Effect": "Deny",
      "Action": [
        "apigateway:DeleteRoutingRule",
        "dynamodb:DeleteBackup",
        "events:DeleteApiDestination",
        "events:DeleteArchive",
        "events:DeleteConnection",
        "events:DeleteEndpoint"
      ],
      "NotResource": [
        "arn:aws:apigateway:<REGION>:<ACCOUNT_ID>:/domainnames/rv-${aws:PrincipalTag/rovara-run}-*/routingrules/*",
        "arn:aws:dynamodb::<ACCOUNT_ID>:global-table/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*/backup/*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*/stream/*",
        "arn:aws:events:<REGION>::event-source/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:api-destination/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:archive/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:connection/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:endpoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:event-bus/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:replay/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:kinesis:<REGION>:<ACCOUNT_ID>:stream/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:layer:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:layer:rv-${aws:PrincipalTag/rovara-run}-*:*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:microvm-image:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:web-function/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:rv-${aws:PrincipalTag/rovara-run}-*:log-stream:*",
        "arn:aws:s3-object-lambda:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:::rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:::rv-${aws:PrincipalTag/rovara-run}-*/*",
        "arn:aws:s3:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*/object/*",
        "arn:aws:sns:<REGION>:<ACCOUNT_ID>:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:resource-data-sync/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:activity:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:mapRun:rv-${aws:PrincipalTag/rovara-run}-*/*:*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:stateMachine:rv-${aws:PrincipalTag/rovara-run}-*"
      ]
    }
  ]
}
