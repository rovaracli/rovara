{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyChangesOutsideRunNames2",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionAcl",
        "s3:PutObjectVersionAnnotation",
        "s3:PutObjectVersionTagging",
        "s3:PutReplicationConfiguration",
        "s3:ReplicateDelete",
        "s3:ReplicateObject",
        "s3:ReplicateObjectAnnotation",
        "s3:ReplicateTags",
        "s3:RestoreObject",
        "s3:UpdateBucketMetadataAnnotationTableConfiguration",
        "s3:UpdateBucketMetadataInventoryTableConfiguration",
        "s3:UpdateBucketMetadataJournalTableConfiguration",
        "s3:UpdateObjectEncryption",
        "sns:Subscribe",
        "sns:TagResource",
        "sns:UntagResource",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "ssm:CreateResourceDataSync",
        "ssm:DeleteResourceDataSync",
        "ssm:UpdateResourceDataSync",
        "states:CreateStateMachineAlias",
        "states:TagResource",
        "states:UntagResource",
        "states:UpdateMapRun"
      ],
      "NotResource": [
        "arn:aws:apigateway:<REGION>:<ACCOUNT_ID>:/domainnames/rv-${aws:PrincipalTag/rovara-run}-*/routingrules/*",
        "arn:aws:dynamodb::<ACCOUNT_ID>:global-table/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*/backup/*",
        "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/rv-${aws:PrincipalTag/rovara-run}-*/stream/*",
        "arn:aws:events:<REGION>::event-source/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:api-destination/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:archive/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:connection/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:endpoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:event-bus/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:events:<REGION>:<ACCOUNT_ID>:replay/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:kinesis:<REGION>:<ACCOUNT_ID>:stream/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:layer:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:layer:rv-${aws:PrincipalTag/rovara-run}-*:*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:microvm-image:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:web-function/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:rv-${aws:PrincipalTag/rovara-run}-*:log-stream:*",
        "arn:aws:s3-object-lambda:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:::rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:::rv-${aws:PrincipalTag/rovara-run}-*/*",
        "arn:aws:s3:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:s3:<REGION>:<ACCOUNT_ID>:accesspoint/rv-${aws:PrincipalTag/rovara-run}-*/object/*",
        "arn:aws:sns:<REGION>:<ACCOUNT_ID>:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:resource-data-sync/rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:activity:rv-${aws:PrincipalTag/rovara-run}-*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:mapRun:rv-${aws:PrincipalTag/rovara-run}-*/*:*",
        "arn:aws:states:<REGION>:<ACCOUNT_ID>:stateMachine:rv-${aws:PrincipalTag/rovara-run}-*"
      ]
    },
    {
      "Sid": "DenyTaggingOtherRuns1",
      "Effect": "Deny",
      "Action": [
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "events:TagResource",
        "events:UntagResource",
        "iam:Tag*",
        "iam:Untag*",
        "kinesis:AddTagsToStream",
        "kinesis:CreateChannel",
        "kinesis:RemoveTagsFromStream",
        "kinesis:TagResource",
        "kinesis:UntagResource",
        "kms:TagResource",
        "kms:UntagResource",
        "lambda:TagResource",
        "lambda:UntagResource",
        "logs:TagLogGroup",
        "logs:TagResource",
        "logs:UntagLogGroup",
        "logs:UntagResource",
        "s3:DeleteJobTagging",
        "s3:DeleteObjectTagging",
        "s3:DeleteObjectVersionTagging",
        "s3:DeleteStorageLensConfigurationTagging",
        "s3:PutBucketTagging",
        "s3:PutJobTagging",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:PutStorageLensConfigurationTagging",
        "s3:ReplicateTags",
        "s3:TagResource",
        "s3:UntagResource",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "sns:TagResource",
        "sns:UntagResource",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "states:TagResource",
        "states:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/rovara-run": "false"
        },
        "StringNotEquals": {
          "aws:ResourceTag/rovara-run": "${aws:PrincipalTag/rovara-run}"
        }
      }
    }
  ]
}
