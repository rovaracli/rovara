# cfn-guard rules for the customer's template (environments/test-access/cloudformation/rovara-test-access.template.yaml).
# What a customer's security review looks for, as checks that fail the build:
#   - the trust policy asks for the external id, names Rovara's role (never a wildcard) and the run tag keys only
#   - every role carries the permissions boundary
#   - no long-lived keys, no IAM users
#   - nothing grants every action on every resource
#   - the boundary is the whole fence, for Rovara's roles and for every role a run creates: an allow list whose every statement is scoped (run-named resources, the run tag, or Rovara's roles for reads),
#     with the denies a shared account needs (secret reads, passing roles, roles without the boundary or the run tag, the run tag itself)
#   - the callback goes to the topic the parameter names
# Run: ~/.local/share/rovara-tools/cfn-guard-3.2.1/cfn-guard validate -r <this file> -d <template> (scripts/test-access/check-templates.sh does it, with cfn-lint).

let roles = Resources.*[ Type == "AWS::IAM::Role" ]
let policies = Resources.*[ Type == "AWS::IAM::ManagedPolicy" ]
let key_resources = Resources.*[ Type in ["AWS::IAM::AccessKey", "AWS::IAM::User", "AWS::IAM::LoginProfile", "AWS::IAM::UserToGroupAddition", "AWS::IAM::ServiceSpecificCredential"] ]

rule no_long_lived_keys {
    %key_resources empty
}

rule roles_exist {
    %roles !empty
}

rule assume_role_requires_external_id when %roles !empty {
    %roles {
        Properties.AssumeRolePolicyDocument.Statement[ Action == "sts:AssumeRole" ] {
            Condition.StringEquals."sts:ExternalId" exists
            Condition.StringEquals."sts:ExternalId" == { "Ref": "ExternalId" }
        }
    }
}

rule trust_policy_has_only_the_two_actions when %roles !empty {
    %roles {
        Properties.AssumeRolePolicyDocument.Statement[*] {
            Effect == "Allow"
            Action in ["sts:AssumeRole", "sts:TagSession"]
        }
    }
}

rule trust_principal_is_the_rovara_parameter when %roles !empty {
    %roles {
        Properties.AssumeRolePolicyDocument.Statement[*] {
            Principal.AWS == { "Ref": "RovaraPrincipal" }
        }
    }
}

rule trust_has_no_wildcard_principal when %roles !empty {
    %roles {
        Properties.AssumeRolePolicyDocument.Statement[*] {
            Principal !is_string
            Principal.AWS !is_list
            when Principal.AWS is_string {
                Principal.AWS != "*"
            }
            Principal.Service not exists
            Principal.Federated not exists
        }
    }
}

rule tag_session_only_with_the_run_tag when %roles !empty {
    %roles {
        Properties.AssumeRolePolicyDocument.Statement[ Action == "sts:TagSession" ] {
            Condition."ForAllValues:StringEquals"."aws:TagKeys"[*] == "rovara-run"
            Condition.StringLike."aws:RequestTag/rovara-run" exists
        }
    }
}

rule every_role_has_the_boundary when %roles !empty {
    %roles {
        Properties.PermissionsBoundary exists
    }
}

rule roles_have_no_inline_admin when %roles !empty {
    %roles {
        Properties.Policies not exists
        Properties.ManagedPolicyArns !empty
    }
}

rule no_allow_everything when %policies !empty {
    %policies {
        Properties.PolicyDocument.Statement[ Effect == "Allow" ] {
            when Action is_string {
                Action != "*"
            }
            when Action is_list {
                Action[ this == "*" ] empty
            }
        }
    }
}

rule the_boundary_requires_the_run_tag {
    Resources.RovaraTestBoundary.Properties.PolicyDocument.Statement[ Sid == "NoTag" ] !empty
    Resources.RovaraTestBoundary.Properties.PolicyDocument.Statement[ Sid == "NoTag" ] {
        Effect == "Deny"
        Condition.Null."aws:PrincipalTag/rovara-run" == "true"
    }
}

rule callback_goes_to_the_topic_parameter {
    Resources.*[ Type == "Custom::RovaraTestAccess" ] {
        Properties.ServiceToken == { "Ref": "CallbackTopicArn" }
        Properties.ServiceTimeout exists
    }
}

rule external_id_is_checked_by_pattern {
    Parameters.ExternalId.AllowedPattern exists
    Parameters.RovaraPrincipal.AllowedPattern exists
    Parameters.ConnectToken.NoEcho == true
}

# ---- the boundary: a regression here makes a role a test run creates stronger than the run (TA1 review items C1, H1, H2, B1 to B5) ----

let boundary_statements = Resources.RovaraTestBoundary.Properties.PolicyDocument.Statement

rule boundary_allows_are_scoped {
    %boundary_statements[ Effect == "Allow" Sid != "Reads" ] {
        Condition exists or Resource !is_string
        Resource[ this == "*" ] empty
    }
}

rule boundary_reads_are_for_rovaras_roles_only {
    %boundary_statements[ Sid == "Reads" ] !empty
    %boundary_statements[ Sid == "Reads" ] {
        Effect == "Allow"
        Condition.ArnNotLike."aws:PrincipalArn" exists
    }
}

# What is allowed by tag is the taking apart of an event source mapping, nothing that could change a resource's tag or reach one that is not the run's.
rule boundary_tag_allow_is_only_event_source_mapping_cleanup {
    %boundary_statements[ Sid == "Tagged" ] {
        Action[*] == /^lambda:(Delete|Get)EventSourceMapping$/
        Condition.StringEquals."aws:ResourceTag/rovara-run" exists
    }
}

# Nothing may let a run set its tag on a resource that exists: the only allow keyed on the request tag is the creation of an event source mapping, and only for a run's own function (B2).
rule boundary_has_no_tagging_by_request_tag {
    %boundary_statements[ Effect == "Allow" Sid != "CreateByTag" ] {
        Condition.StringEquals."aws:RequestTag/rovara-run" not exists
    }
    %boundary_statements[ Sid == "CreateByTag" ] {
        Action[*] == "lambda:CreateEventSourceMapping"
        Action !is_string
        Condition.ArnLike."lambda:FunctionArn" exists
    }
}

rule boundary_s3_names_are_checked_against_the_account {
    %boundary_statements[ Sid == "NamedS3" ] !empty
    %boundary_statements[ Sid == "NamedS3" ] {
        Condition.StringEquals."s3:ResourceAccount" exists
    }
}

rule boundary_denies_secret_reads_outside_the_run {
    %boundary_statements[ Sid == "Secrets" ] !empty
    %boundary_statements[ Sid == "Secrets" ] {
        Effect == "Deny"
        NotResource !empty
        some Action[*] == "secretsmanager:*GetSecretValue"
        some Action[*] == "ssm:GetParameter*"
        some Action[*] == "lambda:GetFunction*"
        some Action[*] == "lambda:ListVersionsByFunction"
    }
}

# Exactly the services tests use to run code, and only that.
rule boundary_limits_pass_role {
    %boundary_statements[ Sid == "Pass" ] !empty
    %boundary_statements[ Sid == "Pass" ] {
        Effect == "Deny"
        Action[*] == "iam:PassRole"
        Condition.StringNotEquals."iam:PassedToService"[*] in ["events.amazonaws.com", "lambda.amazonaws.com", "states.amazonaws.com"]
        Condition.StringNotEquals."iam:PassedToService" !empty
    }
}

# A role a run creates can call no IAM and open no resource policy; its session tag must agree with its name; it has no path and carries this boundary.
rule boundary_fences_the_roles_a_run_creates {
    %boundary_statements[ Sid == "RunRoles" ] !empty
    %boundary_statements[ Sid == "RunRoles" ] {
        Effect == "Deny"
        some Action[*] == "iam:*"
        some Action[*] == "lambda:AddPermission"
        Condition.ArnLike."aws:PrincipalArn" exists
    }
    %boundary_statements[ Sid == "Forged" ] !empty
    %boundary_statements[ Sid == "Forged" ] {
        Effect == "Deny"
        Condition.ArnLike."aws:PrincipalArn" exists
        Condition.ArnNotLike."aws:PrincipalArn" exists
    }
    %boundary_statements[ Sid == "NoPath" ] !empty
    %boundary_statements[ Sid == "Boundary" ] !empty
    %boundary_statements[ Sid == "KeepBoundary" ] !empty
}

rule boundary_refuses_what_spends_the_accounts_pool {
    %boundary_statements[ Sid == "Pool" ] !empty
    %boundary_statements[ Sid == "Pool" ] {
        Effect == "Deny"
        some Action[*] == "lambda:PutFunctionConcurrency"
        some Action[*] == "s3:PutBucketObjectLockConfiguration"
    }
}

rule boundary_keeps_a_rules_targets_the_runs_own {
    %boundary_statements[ Sid == "Targets" ] !empty
    %boundary_statements[ Sid == "Targets" ] {
        Effect == "Deny"
        Condition.ArnNotLike."events:TargetArn" exists
    }
}

rule boundary_keeps_the_run_tag_and_the_region {
    %boundary_statements[ Sid == "TagKey" ] !empty
    %boundary_statements[ Sid == "Region" ] !empty
    %boundary_statements[ Sid == "NoTag" ] !empty
}
