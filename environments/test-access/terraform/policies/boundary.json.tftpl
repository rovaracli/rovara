{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReads",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Describe*",
        "dynamodb:Get*",
        "dynamodb:List*",
        "events:Describe*",
        "events:Get*",
        "events:List*",
        "iam:Describe*",
        "iam:Get*",
        "iam:List*",
        "kinesis:Describe*",
        "kinesis:Get*",
        "kinesis:List*",
        "lambda:Describe*",
        "lambda:Get*",
        "lambda:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:List*",
        "s3:Describe*",
        "s3:Get*",
        "s3:List*",
        "secretsmanager:Describe*",
        "secretsmanager:Get*",
        "secretsmanager:List*",
        "sns:Describe*",
        "sns:Get*",
        "sns:List*",
        "sqs:Describe*",
        "sqs:Get*",
        "sqs:List*",
        "ssm:Describe*",
        "ssm:Get*",
        "ssm:List*",
        "states:Describe*",
        "states:Get*",
        "states:List*",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "logs:FilterLogEvents",
        "sts:GetCallerIdentity",
        "tag:Get*"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:${partition}:iam::${account_id}:role/rv-*",
            "arn:${partition}:sts::${account_id}:assumed-role/rv-*/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowRunNamed",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*",
        "events:*",
        "kinesis:*",
        "lambda:*",
        "logs:*",
        "secretsmanager:*",
        "sns:*",
        "sqs:*",
        "ssm:*",
        "states:*"
      ],
      "Resource": [
        "arn:${partition}:dynamodb:*:${account_id}:global-table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:dynamodb:*:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:*:${account_id}:archive/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:*:${account_id}:event-bus/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:*:${account_id}:rule/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:kinesis:*:${account_id}:stream/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:*:${account_id}:function:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:*:${account_id}:layer:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:*:${account_id}:log-group:/aws/lambda/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:*:${account_id}:log-group:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:secretsmanager:*:${account_id}:secret:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:sns:*:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:sqs:*:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:ssm:*:${account_id}:document/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:ssm:*:${account_id}:parameter/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:*:${account_id}:activity:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:*:${account_id}:execution:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:*:${account_id}:stateMachine:rv-$${aws:PrincipalTag/rovara-run}-*"
      ]
    },
    {
      "Sid": "AllowRunNamedS3",
      "Effect": "Allow",
      "Action": [
        "s3:*"
      ],
      "Resource": [
        "arn:${partition}:s3:::rv-$${aws:PrincipalTag/rovara-run}-*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "${account_id}"
        }
      }
    },
    {
      "Sid": "AllowRunNamedIam",
      "Effect": "Allow",
      "Action": [
        "iam:*"
      ],
      "Resource": [
        "arn:${partition}:iam::${account_id}:instance-profile/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:iam::${account_id}:policy/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:iam::${account_id}:role/rv-$${aws:PrincipalTag/rovara-run}-*"
      ]
    },
    {
      "Sid": "AllowRunTagged",
      "Effect": "Allow",
      "Action": [
        "dynamodb:*",
        "events:*",
        "kinesis:*",
        "lambda:*",
        "logs:*",
        "secretsmanager:*",
        "sns:*",
        "sqs:*",
        "ssm:*",
        "states:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "AllowCreateWithRunTag",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "DenyWithoutRunTag",
      "Effect": "Deny",
      "NotAction": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:PrincipalTag/rovara-run": "true"
        }
      }
    },
    {
      "Sid": "DenyOtherRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "s3:GetBucketLocation",
        "s3:ListAllMyBuckets",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "${region}"
        }
      }
    },
    {
      "Sid": "DenyRunTagChange",
      "Effect": "Deny",
      "Action": [
        "*"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": "rovara-run"
        },
        "StringNotEquals": {
          "aws:RequestTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "DenySecretReadsOutsideRun",
      "Effect": "Deny",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListFunctions",
        "secretsmanager:BatchGetSecretValue",
        "secretsmanager:GetSecretValue",
        "ssm:GetParameter*",
        "ssm:GetParametersByPath",
        "states:DescribeExecution",
        "states:GetActivityTask",
        "states:GetExecutionHistory"
      ],
      "NotResource": [
        "arn:${partition}:lambda:*:${account_id}:function:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:secretsmanager:*:${account_id}:secret:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:ssm:*:${account_id}:parameter/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:*:${account_id}:execution:rv-$${aws:PrincipalTag/rovara-run}-*"
      ]
    },
    {
      "Sid": "DenyRoleWithoutBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:${partition}:iam::${account_id}:policy/rovara-test-boundary-${external_id}"
        }
      }
    },
    {
      "Sid": "DenyRoleWithoutRunTag",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "DenyPassRoleToOtherServices",
      "Effect": "Deny",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PassedToService": [
            "events.amazonaws.com",
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com",
            "states.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemovalAndKeys",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:CreateUser",
        "iam:DeleteRolePermissionsBoundary",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "*"
    }
  ]
}
