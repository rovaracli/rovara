{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyChangesOutsideRunNames2",
      "Effect": "Deny",
      "Action": [
        "s3:PutObjectLegalHold",
        "s3:PutObjectRetention",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionAcl",
        "s3:PutObjectVersionAnnotation",
        "s3:PutObjectVersionTagging",
        "s3:PutReplicationConfiguration",
        "s3:ReplicateDelete",
        "s3:ReplicateObject",
        "s3:ReplicateObjectAnnotation",
        "s3:ReplicateTags",
        "s3:RestoreObject",
        "s3:UpdateBucketMetadataAnnotationTableConfiguration",
        "s3:UpdateBucketMetadataInventoryTableConfiguration",
        "s3:UpdateBucketMetadataJournalTableConfiguration",
        "s3:UpdateObjectEncryption",
        "sns:Subscribe",
        "sns:TagResource",
        "sns:UntagResource",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "ssm:CreateResourceDataSync",
        "ssm:DeleteResourceDataSync",
        "ssm:UpdateResourceDataSync",
        "states:CreateStateMachineAlias",
        "states:TagResource",
        "states:UntagResource",
        "states:UpdateMapRun"
      ],
      "NotResource": [
        "arn:${partition}:apigateway:${region}:${account_id}:/domainnames/rv-$${aws:PrincipalTag/rovara-run}-*/routingrules/*",
        "arn:${partition}:dynamodb::${account_id}:global-table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*/backup/*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*/stream/*",
        "arn:${partition}:events:${region}::event-source/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:api-destination/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:archive/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:connection/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:endpoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:event-bus/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:replay/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:kinesis:${region}:${account_id}:stream/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:function:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:layer:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:layer:rv-$${aws:PrincipalTag/rovara-run}-*:*",
        "arn:${partition}:lambda:${region}:${account_id}:microvm-image:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:web-function/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:${region}:${account_id}:log-group:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:${region}:${account_id}:log-group:rv-$${aws:PrincipalTag/rovara-run}-*:log-stream:*",
        "arn:${partition}:s3-object-lambda:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:::rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:::rv-$${aws:PrincipalTag/rovara-run}-*/*",
        "arn:${partition}:s3:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*/object/*",
        "arn:${partition}:sns:${region}:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:sqs:${region}:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:ssm:${region}:${account_id}:resource-data-sync/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:${region}:${account_id}:activity:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:${region}:${account_id}:mapRun:rv-$${aws:PrincipalTag/rovara-run}-*/*:*",
        "arn:${partition}:states:${region}:${account_id}:stateMachine:rv-$${aws:PrincipalTag/rovara-run}-*"
      ]
    },
    {
      "Sid": "DenyTaggingOtherRuns1",
      "Effect": "Deny",
      "Action": [
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "events:TagResource",
        "events:UntagResource",
        "iam:Tag*",
        "iam:Untag*",
        "kinesis:AddTagsToStream",
        "kinesis:CreateChannel",
        "kinesis:RemoveTagsFromStream",
        "kinesis:TagResource",
        "kinesis:UntagResource",
        "kms:TagResource",
        "kms:UntagResource",
        "lambda:TagResource",
        "lambda:UntagResource",
        "logs:TagLogGroup",
        "logs:TagResource",
        "logs:UntagLogGroup",
        "logs:UntagResource",
        "s3:DeleteJobTagging",
        "s3:DeleteObjectTagging",
        "s3:DeleteObjectVersionTagging",
        "s3:DeleteStorageLensConfigurationTagging",
        "s3:PutBucketTagging",
        "s3:PutJobTagging",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:PutStorageLensConfigurationTagging",
        "s3:ReplicateTags",
        "s3:TagResource",
        "s3:UntagResource",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "sns:TagResource",
        "sns:UntagResource",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "states:TagResource",
        "states:UntagResource"
      ],
      "Resource": "*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/rovara-run": "false"
        },
        "StringNotEquals": {
          "aws:ResourceTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    }
  ]
}
