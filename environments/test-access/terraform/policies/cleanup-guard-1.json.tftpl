{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyChangesToOtherResources1",
      "Effect": "Deny",
      "Action": [
        "apigateway:DeletePortal",
        "apigateway:DeletePortalProduct",
        "apigateway:DeleteProductPage",
        "apigateway:DeleteProductRestEndpointPage",
        "dynamodb:DeleteGlobalTableWitness",
        "dynamodb:DeleteItem",
        "dynamodb:DeleteTable",
        "dynamodb:DeleteTableReplica",
        "events:DeleteEventBus",
        "events:DeleteEventSource",
        "events:DeleteRule",
        "events:DeleteSubscriber",
        "events:RemoveTargets",
        "iam:DeleteAccessKey",
        "iam:DeleteInstanceProfile",
        "iam:DeleteLoginProfile",
        "iam:DeleteOpenIDConnectProvider",
        "iam:DeleteRole",
        "iam:DeleteSAMLProvider",
        "iam:DeleteSSHPublicKey",
        "iam:DeleteServerCertificate",
        "iam:DeleteServiceLinkedRole",
        "iam:DeleteServiceSpecificCredential",
        "iam:DeleteSigningCertificate",
        "iam:DeleteUser",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:RemoveRoleFromInstanceProfile",
        "kinesis:Delete*",
        "kinesis:DeregisterStreamConsumer",
        "kms:DeleteImportedKeyMaterial",
        "lambda:DeleteAlias",
        "lambda:DeleteCapacityProvider",
        "lambda:DeleteCodeSigningConfig",
        "lambda:DeleteEventSourceMapping",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionCodeSigningConfig",
        "lambda:DeleteFunctionConcurrency",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:DeleteMicrovmImage",
        "lambda:DeleteMicrovmImageVersion",
        "lambda:DeleteNetworkConnector",
        "lambda:DeleteProvisionedConcurrencyConfig",
        "lambda:DeleteWebFunction",
        "lambda:DeleteWebFunctionEndpoint",
        "lambda:DeleteWebFunctionRevision",
        "lambda:TerminateMicrovm",
        "logs:DeleteDataProtectionPolicy",
        "logs:DeleteDelivery",
        "logs:DeleteDeliveryDestination",
        "logs:DeleteDeliveryDestinationPolicy",
        "logs:DeleteDeliverySource",
        "logs:DeleteDestination",
        "logs:DeleteLogAnomalyDetector",
        "logs:DeleteLogGroup",
        "logs:DeleteLogStream",
        "logs:DeleteLookupTable",
        "logs:DeleteMetricFilter",
        "logs:DeleteRetentionPolicy",
        "logs:DeleteScheduledQuery",
        "logs:DeleteSubscriptionFilter",
        "logs:DeleteSyslogConfiguration",
        "logs:DeleteTransformer",
        "s3:DeleteStorageLensConfiguration",
        "s3:DeleteStorageLensGroup",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RemoveRegionsFromReplication",
        "sns:DeleteTopic",
        "sqs:DeleteMessage",
        "sqs:DeleteQueue",
        "sqs:PurgeQueue",
        "ssm:DeleteAssociation",
        "ssm:DeleteCloudConnector",
        "ssm:DeleteDocument",
        "ssm:DeleteMaintenanceWindow",
        "ssm:DeleteOpsItem",
        "ssm:DeleteOpsMetadata",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:DeletePatchBaseline",
        "ssm:DeregisterManagedInstance",
        "ssm:DeregisterPatchBaselineForPatchGroup",
        "ssm:DeregisterTargetFromMaintenanceWindow",
        "ssm:DeregisterTaskFromMaintenanceWindow",
        "states:Delete*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/rovara-run": "$${aws:PrincipalTag/rovara-run}"
        }
      }
    },
    {
      "Sid": "DenyChangesOutsideRunNames1",
      "Effect": "Deny",
      "Action": [
        "apigateway:DeleteRoutingRule",
        "dynamodb:DeleteBackup",
        "events:DeleteApiDestination",
        "events:DeleteArchive",
        "events:DeleteConnection",
        "events:DeleteEndpoint"
      ],
      "NotResource": [
        "arn:${partition}:apigateway:${region}:${account_id}:/domainnames/rv-$${aws:PrincipalTag/rovara-run}-*/routingrules/*",
        "arn:${partition}:dynamodb::${account_id}:global-table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*/backup/*",
        "arn:${partition}:dynamodb:${region}:${account_id}:table/rv-$${aws:PrincipalTag/rovara-run}-*/stream/*",
        "arn:${partition}:events:${region}::event-source/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:api-destination/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:archive/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:connection/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:endpoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:event-bus/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:events:${region}:${account_id}:replay/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:kinesis:${region}:${account_id}:stream/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:function:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:layer:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:layer:rv-$${aws:PrincipalTag/rovara-run}-*:*",
        "arn:${partition}:lambda:${region}:${account_id}:microvm-image:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:lambda:${region}:${account_id}:web-function/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:${region}:${account_id}:log-group:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:logs:${region}:${account_id}:log-group:rv-$${aws:PrincipalTag/rovara-run}-*:log-stream:*",
        "arn:${partition}:s3-object-lambda:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:::rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:::rv-$${aws:PrincipalTag/rovara-run}-*/*",
        "arn:${partition}:s3:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:s3:${region}:${account_id}:accesspoint/rv-$${aws:PrincipalTag/rovara-run}-*/object/*",
        "arn:${partition}:sns:${region}:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:sqs:${region}:${account_id}:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:ssm:${region}:${account_id}:resource-data-sync/rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:${region}:${account_id}:activity:rv-$${aws:PrincipalTag/rovara-run}-*",
        "arn:${partition}:states:${region}:${account_id}:mapRun:rv-$${aws:PrincipalTag/rovara-run}-*/*:*",
        "arn:${partition}:states:${region}:${account_id}:stateMachine:rv-$${aws:PrincipalTag/rovara-run}-*"
      ]
    }
  ]
}
