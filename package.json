{
  "name": "agentx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:web",
    "clean": "tsc -b --clean",
    "lint": "node scripts/lint-shards.ts",
    "lint:single": "node --max-old-space-size=14336 node_modules/eslint/bin/eslint.js .",
    "test": "vitest run",
    "test:browser": "playwright test -c tests/web/browser/playwright.config.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:all": "tsc -b --pretty false && node scripts/typecheck-baseline.ts check",
    "typecheck:changed": "tsc -b --pretty false && node scripts/typecheck-baseline.ts check --changed",
    "typecheck:baseline": "tsc -b --pretty false && node scripts/typecheck-baseline.ts update",
    "infra:synth": "npm run build --workspace @agentx/infra && cdk synth --app \"node infra/dist/bin/agentx.js\" -c rovaraCloudApp=production -q && cdk synth --app \"node infra/dist/bin/agentx.js\" -c rovaraCloudPipeline=production -q",
    "cloud:local": "tsx scripts/cloud-server.ts",
    "fake-code": "tsx scripts/fake-code.ts",
    "contract:table": "tsx scripts/code-contract-table.ts",
    "build:web": "npm run build --workspace @agentx/web && npx tsx scripts/web-precompress.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
