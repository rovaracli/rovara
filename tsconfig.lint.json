{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "infra/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "cdk.out/**",
    ".release-synth/**",
    "packages/ui/**",
    "packages/web/**",
    "tests/web/**",
    "tests/web-e2e/**"
  ]
}
